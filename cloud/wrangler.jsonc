{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "range-christmas-control",
  "account_id": "00e75d4dd372e689536c857546f4e1b5",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "triggers": {"crons": ["0 23 * * *", "*/5 * * * *"]},
  "durable_objects": {"bindings": [{"name": "CONTROL", "class_name": "Control"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Control"]}],
  "observability": {"enabled": false}
}
